{
  "version": 1,
  "playwright": {
    "run_id_env": "HEIMDAL_RUN_ID",
    "port_env": "HEIMDAL_PORT"
  },
  "session": {
    "run_id_env": "HEIMDAL_RUN_ID",
    "port_env": "HEIMDAL_PORT",
    "browser_launch_options": {}
  },
  "doctor": {},
  "artifacts": {
    "directory": ".heimdal",
    "retention": {
      "enabled": true,
      "max_age_days": 14,
      "keep_failures": 20,
      "max_bytes": 5368709120,
      "thin_repeated_failures": true
    }
  }
}
